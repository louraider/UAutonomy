{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/android", "destination": "https://github.com/louraider/UAutonomy/releases/download/app/avtonomiia.apk", "permanent": false },
    { "source": "/apk", "destination": "https://github.com/louraider/UAutonomy/releases/download/app/avtonomiia.apk", "permanent": false },
    { "source": "/windows", "destination": "https://github.com/louraider/UAutonomy/releases/download/app/avtonomiia-windows-x64.zip", "permanent": false },
    { "source": "/sha256", "destination": "https://github.com/louraider/UAutonomy/releases/download/app/SHA256SUMS.txt", "permanent": false },
    { "source": "/catalog.json", "destination": "https://github.com/louraider/UAutonomy/releases/download/packs/catalog.json", "permanent": false },
    { "source": "/github", "destination": "https://github.com/louraider/UAutonomy", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
